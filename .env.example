# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/multiwa_arabic"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# WhatsApp API
WA_ENGINE="baileys"
WA_API_URL="http://localhost:4000"

# Redis (for queue)
REDIS_URL="redis://localhost:6379"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Email (for notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@example.com"
SMTP_PASSWORD="password"

# Payment Gateway
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""

# App Settings
APP_NAME="MultiWA عربي"
APP_URL="https://multiwa-ar.com"
ADMIN_EMAIL="admin@multiwa-ar.com"

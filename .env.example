# ===== واتساب تكوين — مثال ملف البيئة =====
# انسخ هذا الملف إلى .env وعدّل القيم

# قاعدة البيانات: تُستخدم القاعدة المحلية على السيرفر تلقائياً
# (mongodb://127.0.0.1:27017/wats) — لا حاجة لتعيين هذا المتغير إلا إذا أردت
# الاتصال بقاعدة أخرى
# MONGODB_URI=mongodb://127.0.0.1:27017/wats

# حساب المدير (الأدمن) — يُنشأ تلقائياً عند أول تشغيل
ADMIN_USERNAME=admin
ADMIN_PASSWORD=غيّر-هذه-الكلمة

# مفتاح سري لتشفير جلسات الدخول — غيّره لقيمة عشوائية طويلة
SESSION_SECRET=غيّر-هذا-المفتاح-إلى-سلسلة-عشوائية-طويلة

# منفذ التطبيق
PORT=3000

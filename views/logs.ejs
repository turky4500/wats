<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سجل الرسائل | واتساب تكوين</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #25d366; --primary-dark: #1da851; --primary-light: #dcfce7;
            --accent: #6366f1; --accent-light: #eef2ff;
            --blue: #3b82f6; --blue-light: #eff6ff;
            --danger: #ef4444; --danger-light: #fef2f2;
            --dark: #0f172a; --dark2: #1e293b; --gray: #64748b; --gray-light: #94a3b8;
            --bg: #f1f5f9; --card: #ffffff;
            --shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
            --shadow-lg: 0 10px 25px -5px rgba(0,0,0,0.08);
            --radius: 16px;
        }
        body { font-family: 'Tajawal', sans-serif; background: var(--bg); color: var(--dark2); line-height: 1.7; }

        /* Top Bar (نفس الشكل الحالي) */
        .topbar { background: linear-gradient(135deg, var(--dark) 0%, var(--dark2) 100%); color: white; padding: 0 40px; display: flex; justify-content: space-between; align-items: center; height: 65px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
        .topbar-brand { display: flex; align-items: center; gap: 12px; font-weight: 900; font-size: 18px; }
        .topbar-actions { display: flex; gap: 10px; }
        .topbar-actions a { color: rgba(255,255,255,0.7); text-decoration: none; padding: 8px 18px; border-radius: 8px; font-size: 13px; font-weight: 700; transition: all 0.2s; }
        .topbar-actions a:hover { background: rgba(255,255,255,0.1); color: white; }
        .topbar-actions .btn-back { background: rgba(255,255,255,0.1); color: white; }

        .container { max-width: 1200px; margin: 0 auto; padding: 30px 40px; }

        /* Page Header */
        .page-header { margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        .page-header h1 { font-size: 26px; font-weight: 900; color: var(--dark); display: flex; align-items: center; gap: 10px; }
        .page-header .subtitle { color: var(--gray); font-size: 14px; margin-top: 4px; }

        /* Filter Card (نفس الشكل) */
        .filter-card { background: linear-gradient(135deg, var(--primary-light) 0%, #f0fdf4 100%); border: 1px solid #bbf7d0; border-radius: var(--radius); padding: 22px 28px; margin-bottom: 25px; }
        .filter-form { display: flex; gap: 15px; align-items: flex-end; flex-wrap: wrap; }
        .filter-group { flex: 1; min-width: 180px; }
        .filter-group label { display: block; font-weight: 700; font-size: 13px; color: #166534; margin-bottom: 6px; }
        .filter-group input { width: 100%; padding: 11px 14px; border: 2px solid #86efac; border-radius: 10px; font-family: inherit; font-size: 14px; outline: none; background: white; transition: border 0.2s; }
        .filter-group input:focus { border-color: var(--primary); }
        .filter-actions { display: flex; gap: 8px; }

        /* Stats Row (نفس الشكل) */
        .log-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 25px; }
        .log-stat { background: var(--card); border-radius: 12px; padding: 18px 20px; box-shadow: var(--shadow); border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 15px; }
        .log-stat-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
        .log-stat-info .value { font-size: 24px; font-weight: 900; color: var(--dark); line-height: 1; }
        .log-stat-info .label { font-size: 12px; color: var(--gray); font-weight: 600; }

        /* Table Card */
        .table-card { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid #e2e8f0; overflow: hidden; }
        .table-header { padding: 20px 25px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        .table-header h3 { font-size: 17px; font-weight: 800; display: flex; align-items: center; gap: 8px; }

        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        thead th { background: #f8fafc; color: var(--gray); font-weight: 700; padding: 14px 20px; text-align: right; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #e2e8f0; }
        tbody td { padding: 14px 20px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
        tbody tr { transition: background 0.15s; }
        tbody tr:hover { background: #fafbff; }

        /* ===== التصميم الاحترافي الجديد للأعمدة ===== */
        .msg-cell { max-width: 340px; }
        .msg-preview { display: flex; align-items: center; gap: 10px; }
        .msg-bubble-mini {
            background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px;
            padding: 8px 14px; font-size: 13px; color: var(--dark2);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px;
            position: relative;
        }
        .msg-bubble-mini::after { content: '💬'; position: absolute; top: 50%; transform: translateY(-50%); left: -8px; opacity: 0; }
        .view-btn {
            background: #f8fafc; border: 1.5px solid #e2e8f0; color: #166534;
            border-radius: 8px; padding: 6px 12px; font-size: 12px; font-weight: 800;
            cursor: pointer; font-family: inherit; transition: all 0.2s; white-space: nowrap;
            display: inline-flex; align-items: center; gap: 5px;
        }
        .view-btn:hover { background: var(--primary-light); border-color: var(--primary); transform: translateY(-1px); }

        .phone-cell { font-weight: 800; color: var(--dark); direction: ltr; font-family: 'Courier New', monospace; font-size: 13px; display: flex; align-items: center; gap: 8px; }
        .copy-mini-btn {
            background: none; border: 1px solid #e2e8f0; color: var(--gray);
            width: 26px; height: 26px; border-radius: 7px; cursor: pointer; font-size: 12px;
            display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s;
        }
        .copy-mini-btn:hover { background: var(--primary-light); border-color: var(--primary); color: #166534; }
        .copy-mini-btn.copied { background: var(--primary); color: #fff; border-color: var(--primary); }

        .time-cell { color: var(--gray); font-size: 13px; direction: ltr; white-space: nowrap; }

        .badge { display: inline-flex; align-items: center; gap: 5px; padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: 800; }
        .badge-success { background: var(--primary-light); color: #059669; }
        .badge-failed { background: var(--danger-light); color: #dc2626; }
        .err-detail { font-size: 11px; color: var(--danger); margin-top: 4px; display: block; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        .empty-state { text-align: center; padding: 60px 20px; }
        .empty-state .icon { font-size: 50px; margin-bottom: 15px; }
        .empty-state h4 { color: var(--dark2); font-size: 18px; margin-bottom: 8px; }
        .empty-state p { color: var(--gray-light); font-size: 14px; }

        /* Buttons */
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 20px; border: none; border-radius: 10px; font-family: inherit; font-weight: 700; font-size: 13px; cursor: pointer; text-decoration: none; transition: all 0.2s; color: white; }
        .btn:hover { transform: translateY(-1px); }
        .btn-blue { background: var(--blue); }
        .btn-red { background: var(--danger); }
        .btn-dark { background: var(--dark2); }
        .btn-outline { background: white; color: var(--dark2); border: 2px solid #e2e8f0; }
        .btn-outline:hover { border-color: var(--primary); color: #166534; }

        .btn-green { background: var(--primary); }
        .btn-green:disabled { background: #94a3b8; cursor: not-allowed; opacity: 0.6; transform: none !important; }
        .row-checkbox, .check-all { width: 18px; height: 18px; cursor: pointer; accent-color: var(--primary); }
        .selection-info { background: var(--primary-light); border: 1px solid var(--primary); color: #065f46; padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 700; display: none; align-items: center; gap: 8px; }
        .selection-info.active { display: inline-flex; }
        .header-tools { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

        /* Search box (جديد) */
        .search-box { position: relative; }
        .search-box input {
            padding: 10px 16px 10px 38px; border: 2px solid #e2e8f0; border-radius: 10px;
            font-family: inherit; font-size: 13px; width: 240px; outline: none; transition: all 0.2s; background: white;
        }
        .search-box input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,211,102,0.12); }
        .search-box .s-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--gray-light); font-size: 14px; pointer-events: none; }
        .search-box .s-clear { position: absolute; left: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--gray-light); cursor: pointer; font-size: 14px; display: none; }

        /* Modal عام */
        .modal-overlay { position: fixed; inset: 0; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 1000; display: none; align-items: center; justify-content: center; padding: 20px; }
        .modal-overlay.active { display: flex; }
        .modal { background: var(--card); border-radius: var(--radius); box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); width: 100%; max-width: 720px; max-height: 90vh; overflow: hidden; display: flex; flex-direction: column; animation: modalIn 0.2s ease-out; }
        @keyframes modalIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .modal-head { padding: 20px 25px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; background: linear-gradient(135deg, var(--primary-light), #f0fdf4); }
        .modal-head h3 { font-size: 17px; font-weight: 800; color: var(--dark); display: flex; align-items: center; gap: 8px; }
        .modal-close { background: none; border: none; font-size: 22px; cursor: pointer; color: var(--gray); padding: 4px 10px; border-radius: 6px; transition: all 0.2s; }
        .modal-close:hover { background: rgba(0,0,0,0.05); color: var(--dark); }
        .modal-body { padding: 22px 25px; overflow-y: auto; flex: 1; }
        .modal-foot { padding: 16px 25px; border-top: 1px solid #f1f5f9; background: #f8fafc; display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }

        .resend-item { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 16px; margin-bottom: 12px; position: relative; }
        .resend-item.removed { opacity: 0.4; }
        .resend-item.invalid { border-color: var(--danger); background: var(--danger-light); }
        .resend-item-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .resend-item-head strong { font-size: 12px; color: var(--gray); font-weight: 700; }
        .resend-remove { background: none; border: none; color: var(--danger); cursor: pointer; font-size: 14px; padding: 4px 8px; border-radius: 6px; transition: all 0.15s; }
        .resend-remove:hover { background: var(--danger-light); }
        .resend-field { margin-bottom: 8px; }
        .resend-field label { display: block; font-size: 11px; font-weight: 700; color: var(--gray); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.3px; }
        .resend-field input, .resend-field textarea { width: 100%; padding: 9px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; font-family: inherit; font-size: 14px; outline: none; }
        .resend-field input:focus, .resend-field textarea:focus { border-color: var(--primary); }
        .progress-bar { width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; overflow: hidden; margin: 15px 0; display: none; }
        .progress-bar.active { display: block; }
        .progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--primary), #128C7E); border-radius: 4px; transition: width 0.4s; }
        .result-box { padding: 14px 18px; border-radius: 10px; margin-top: 12px; display: none; font-size: 14px; }
        .result-box.active { display: block; }
        .result-box.success { background: var(--primary-light); color: #065f46; border: 1px solid var(--primary); }
        .result-box.partial { background: #fef3c7; color: #92400e; border: 1px solid #f59e0b; }
        .result-box.error { background: var(--danger-light); color: #991b1b; border: 1px solid var(--danger); }
        .result-box h4 { font-weight: 800; margin-bottom: 6px; }
        .result-box ul { margin: 8px 0 0 0; padding: 0; list-style: none; max-height: 150px; overflow-y: auto; }
        .result-box li { padding: 4px 0; font-size: 12px; direction: ltr; text-align: right; border-bottom: 1px dashed rgba(0,0,0,0.08); }
        .result-box li:last-child { border-bottom: none; }

        /* ===== نافذة عرض الرسالة (أسلوب واتساب) ===== */
        .detail-wa-wrap { background: #e5ddd5; border-radius: 14px; padding: 18px; position: relative; min-height: 120px; }
        .detail-bubble {
            background: #fff; border-radius: 12px; border-top-right-radius: 4px;
            padding: 12px 16px; font-size: 14.5px; line-height: 1.9; color: var(--dark2);
            box-shadow: 0 1px 2px rgba(0,0,0,0.1); max-width: 88%; word-break: break-word; white-space: pre-wrap;
        }
        .detail-bubble .dtime { display: block; font-size: 10.5px; color: var(--gray-light); text-align: left; margin-top: 8px; direction: ltr; }
        .detail-bubble .double-check { color: #53bdeb; font-size: 12px; margin-left: 3px; }
        .detail-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin: 18px 0; }
        .meta-item { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 16px; }
        .meta-item label { display: block; font-size: 11px; font-weight: 800; color: var(--gray); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.4px; }
        .meta-item .val { font-size: 14px; font-weight: 800; color: var(--dark); direction: ltr; text-align: right; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .meta-item .val.normal { direction: rtl; font-weight: 700; }
        .meta-actions { display: flex; gap: 10px; flex-wrap: wrap; }
        .err-box { background: var(--danger-light); border: 1px solid #fecaca; border-radius: 12px; padding: 12px 16px; color: #991b1b; font-size: 13px; margin-top: 14px; }
        .err-box label { font-weight: 800; display: block; margin-bottom: 4px; }

        /* ===== نافذة عرض الأرقام ===== */
        .nums-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
        .nums-toolbar .count-badge { background: var(--primary-light); color: #065f46; font-weight: 800; font-size: 13px; padding: 7px 16px; border-radius: 20px; }
        .nums-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; max-height: 46vh; overflow-y: auto; padding-left: 4px; }
        .num-chip {
            background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;
            padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; gap: 8px;
            direction: ltr; font-family: 'Courier New', monospace; font-size: 13px; font-weight: 800; color: var(--dark);
            transition: all 0.15s; cursor: pointer;
        }
        .num-chip:hover { border-color: var(--primary); background: var(--primary-light); }
        .num-chip .num-copy { background: none; border: none; cursor: pointer; font-size: 13px; color: var(--gray); padding: 2px 6px; border-radius: 6px; }
        .num-chip .num-copy:hover { color: #166534; }
        .nums-empty { text-align: center; color: var(--gray-light); padding: 30px; font-size: 14px; }

        /* Toast صغير */
        .mini-toast { position: fixed; bottom: 25px; left: 50%; transform: translateX(-50%) translateY(80px); background: var(--dark); color: #fff; padding: 11px 22px; border-radius: 10px; font-size: 13px; font-weight: 700; z-index: 2000; transition: transform 0.3s; opacity: 0; pointer-events: none; box-shadow: 0 10px 25px rgba(0,0,0,0.3); }
        .mini-toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
        .mini-toast.green { background: #059669; }

        @media (max-width: 768px) {
            .container { padding: 20px 16px; }
            .topbar { padding: 0 16px; }
            .msg-bubble-mini { max-width: 140px; }
            .search-box input { width: 100%; }
            .search-box { width: 100%; }
            .table-header { padding: 16px; }
            thead th, tbody td { padding: 12px 12px; }
        }
    </style>
</head>
<body>
    <!-- Top Bar -->
    <div class="topbar">
        <div class="topbar-brand">
            <span><% if(isAdminView) { %>👑<% } else { %>📜<% } %></span>
            <span>سجل الرسائل</span>
            <% if(isAdminView && allClientsView) { %><span style="background:rgba(245,158,11,0.2); color:#fcd34d; padding:3px 12px; border-radius:20px; font-size:11px;">📋 سجل كل العملاء</span><% } %>
            <% if(isAdminView && !allClientsView) { %><span style="background:rgba(245,158,11,0.2); color:#fcd34d; padding:3px 12px; border-radius:20px; font-size:11px;">عرض الإدارة — <%= user.username %></span><% } %>
        </div>
        <div class="topbar-actions">
            <a href="<%= isAdminView ? '/admin' : '/dashboard' %>" class="btn-back">← العودة للوحة</a>
            <% if (isAdminView) { %>
                <a href="/admin/logs" class="btn-back" style="background:rgba(59,130,246,.2); color:#93c5fd;">📋 كل العملاء</a>
            <% } %>
            <a href="/logout" style="background:rgba(229,72,77,.2); color:#fca5a5;">تسجيل الخروج</a>
        </div>
    </div>

    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h1>📋 سجل الإرسال</h1>
                <p class="subtitle">
                    <% if(isAdminView && allClientsView) { %>سجلات جميع العملاء في المنصة<% } %>
                    <% if(isAdminView && !allClientsView) { %>سجلات العميل: <strong><%= user.username %></strong><% } %>
                    <% if(!isAdminView) { %>جميع رسائلك المرسلة<% } %>
                    <% if(query.dateFrom) { %> — تصفية: <%= query.dateFrom %> إلى <%= query.dateTo %><% } %>
                    <% if(query.status) { %> — الحالة: <%= query.status === 'success' ? 'ناجحة فقط' : 'فاشلة فقط' %><% } %>
                </p>
            </div>
        </div>

        <!-- Quick Stats -->
        <%
            let sCount = 0, fCount = 0;
            logs.forEach(l => { if(l.status === 'success') sCount++; else fCount++; });
            let uniqueNumbers = [];
            logs.forEach(l => { if(!uniqueNumbers.includes(l.to)) uniqueNumbers.push(l.to); });
            const st = (typeof stats !== 'undefined' && stats) || {};
            const todayTotal = st.todayCount || 0;
        %>
        <div class="log-stats">
            <% if(isAdminView && allClientsView) { %>
                <div class="log-stat">
                    <div class="log-stat-icon" style="background: var(--blue-light); color: var(--blue);">📊</div>
                    <div class="log-stat-info">
                        <div class="value"><%= st.totalAll || 0 %></div>
                        <div class="label">إجمالي رسائل المنصة</div>
                    </div>
                </div>
                <div class="log-stat">
                    <div class="log-stat-icon" style="background: var(--primary-light); color: var(--primary);">📨</div>
                    <div class="log-stat-info">
                        <div class="value"><%= todayTotal %></div>
                        <div class="label">اليوم (ناجحة <%= st.todaySuccess || 0 %> / فاشلة <%= st.todayFailed || 0 %>)</div>
                    </div>
                </div>
                <div class="log-stat">
                    <div class="log-stat-icon" style="background: var(--accent-light); color: var(--accent);">📅</div>
                    <div class="log-stat-info">
                        <div class="value"><%= st.weekCount || 0 %></div>
                        <div class="label">آخر 7 أيام</div>
                    </div>
                </div>
            <% } else { %>
                <div class="log-stat">
                    <div class="log-stat-icon" style="background: var(--blue-light); color: var(--blue);">📨</div>
                    <div class="log-stat-info">
                        <div class="value"><%= st.totalAll || logs.length %></div>
                        <div class="label">إجمالي رسائلك</div>
                    </div>
                </div>
                <div class="log-stat">
                    <div class="log-stat-icon" style="background: var(--primary-light); color: var(--primary);">✅</div>
                    <div class="log-stat-info">
                        <div class="value"><%= st.todaySuccess || 0 %></div>
                        <div class="label">نجحت اليوم</div>
                    </div>
                </div>
                <div class="log-stat">
                    <div class="log-stat-icon" style="background: var(--danger-light); color: var(--danger);">❌</div>
                    <div class="log-stat-info">
                        <div class="value"><%= st.todayFailed || 0 %></div>
                        <div class="label">فشلت اليوم</div>
                    </div>
                </div>
            <% } %>
            <div class="log-stat">
                <div class="log-stat-icon" style="background: var(--primary-light); color: var(--primary);">✅</div>
                <div class="log-stat-info">
                    <div class="value"><%= sCount %></div>
                    <div class="label">ناجحة (معروض)</div>
                </div>
            </div>
            <div class="log-stat">
                <div class="log-stat-icon" style="background: var(--danger-light); color: var(--danger);">❌</div>
                <div class="log-stat-info">
                    <div class="value"><%= fCount %></div>
                    <div class="label">فاشلة (معروض)</div>
                </div>
            </div>
            <% if(!isAdminView) { %>
                <div class="log-stat" style="cursor:pointer;" onclick="openNumbersModal()" title="عرض جميع الأرقام">
                    <div class="log-stat-icon" style="background: var(--accent-light); color: var(--accent);">📱</div>
                    <div class="log-stat-info">
                        <div class="value"><%= uniqueNumbers.length %></div>
                        <div class="label">أرقام فريدة — عرض ←</div>
                    </div>
                </div>
                <div class="log-stat">
                    <div class="log-stat-icon" style="background: var(--accent-light); color: var(--accent);">📈</div>
                    <div class="log-stat-info">
                        <div class="value"><%= logs.length > 0 ? Math.round((sCount/logs.length)*100) : 0 %>%</div>
                        <div class="label">نسبة النجاح (المعروض)</div>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- Filter -->
        <div class="filter-card">
            <form method="GET" action="" class="filter-form">
                <% if(isAdminView && allClientsView) { %>
                    <div class="filter-group">
                        <label>👥 العميل</label>
                        <select name="userId" onchange="this.form.submit()" style="width:100%; padding:11px 14px; border:2px solid #86efac; border-radius:10px; font-family:inherit; font-size:14px; background:white;">
                            <option value="">— كل العملاء —</option>
                            <% (clients || []).forEach(c => { %>
                                <option value="<%= c._id %>" <%= String(query.userId) === String(c._id) ? 'selected' : '' %>><%= c.username %> (<%= c.phone || 'بدون رقم' %>)</option>
                            <% }); %>
                        </select>
                    </div>
                <% } %>
                <div class="filter-group">
                    <label>📅 من تاريخ</label>
                    <input type="date" name="dateFrom" value="<%= query.dateFrom || '' %>">
                </div>
                <div class="filter-group">
                    <label>📅 إلى تاريخ</label>
                    <input type="date" name="dateTo" value="<%= query.dateTo || '' %>">
                </div>
                <div class="filter-group">
                    <label>🔵 الحالة</label>
                    <select name="status" style="width:100%; padding:11px 14px; border:2px solid #86efac; border-radius:10px; font-family:inherit; font-size:14px; background:white;">
                        <option value="">— الكل —</option>
                        <option value="success" <%= query.status === 'success' ? 'selected' : '' %>>✅ ناجحة</option>
                        <option value="failed" <%= query.status === 'failed' ? 'selected' : '' %>>❌ فاشلة</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-blue">🔍 بحث</button>
                    <% if(query.dateFrom || query.status || query.userId) { %>
                        <a href="?" class="btn btn-outline">✕ إلغاء</a>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- Table -->
        <div class="table-card">
            <div class="table-header">
                <h3>📄 قائمة الرسائل</h3>
                <div class="header-tools">
                    <div class="search-box">
                        <span class="s-icon">🔎</span>
                        <input type="text" id="searchInput" placeholder="ابحث برقم أو نص الرسالة..." oninput="applySearch()">
                        <button class="s-clear" id="searchClear" onclick="clearSearch()">✕</button>
                    </div>
                    <span class="selection-info" id="selectionInfo">✓ <span id="selectionCount">0</span> محددة</span>
                    <% if(!isAdminView) { %>
                        <button type="button" class="btn btn-green" id="btnResendSelected" disabled>🔄 إعادة إرسال المحدد</button>
                        <button type="button" class="btn btn-outline" id="btnSelectFailed">❌ تحديد الفاشلة فقط</button>
                    <% } %>
                    <% if(!isAdminView || !allClientsView) { %>
                        <button type="button" class="btn btn-dark" onclick="openNumbersModal()">📱 عرض الأرقام (<%= uniqueNumbers.length %>)</button>
                    <% } %>
                    <form action="/logs/delete" method="POST" onsubmit="return confirm('⚠️ هل أنت متأكد من حذف جميع السجلات؟ لا يمكن التراجع!');" style="margin:0;">
                        <% if(isAdminView && !allClientsView) { %>
                            <input type="hidden" name="targetUserId" value="<%= user._id %>">
                        <% } %>
                        <button type="submit" class="btn btn-red">🗑️ <%= (isAdminView && allClientsView) ? 'تفريغ كل السجلات' : 'تفريغ الأرشيف' %></button>
                    </form>
                </div>
            </div>

            <% if(logs.length === 0) { %>
                <div class="empty-state">
                    <div class="icon">📭</div>
                    <h4>لا توجد سجلات</h4>
                    <p>لم يتم العثور على رسائل مطابقة للبحث</p>
                </div>
            <% } else { %>
                <div style="overflow-x: auto;">
                    <table id="logsTable">
                        <thead>
                            <tr>
                                <th style="width:40px;"><input type="checkbox" class="check-all" id="checkAll" title="تحديد الكل"></th>
                                <th style="width:44px;">#</th>
                                <% if(isAdminView && allClientsView) { %>
                                    <th>👤 العميل</th>
                                <% } %>
                                <th>التاريخ والوقت</th>
                                <th>المستلم</th>
                                <th>محتوى الرسالة</th>
                                <th>الحالة</th>
                                <th style="width:70px;">عرض</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% logs.forEach((log, idx) => { %>
                            <tr data-log-id="<%= log._id %>" data-to="<%= log.to %>" data-body="<%= log.body.replace(/\"/g, '&quot;') %>" data-status="<%= log.status %>" data-err="<%= (log.errorDetails || '').replace(/\"/g, '&quot;') %>" data-time="<%= log.createdAt.toISOString() %>">
                                <td><input type="checkbox" class="row-checkbox" value="<%= log._id %>"></td>
                                <td style="color: var(--gray-light); font-weight: 700;"><%= idx + 1 %></td>
                                <% if(isAdminView && allClientsView) { %>
                                    <td>
                                        <% if (log.client) { %>
                                            <a href="/admin/logs/<%= log.client._id %>" style="font-weight:800; color:var(--blue); text-decoration:none;"><%= log.client.username %></a>
                                        <% } else { %>
                                            <span style="color:var(--gray-light);">عميل محذوف</span>
                                        <% } %>
                                    </td>
                                <% } %>
                                <td class="time-cell"><%= log.createdAt.toLocaleString('ar-EG', { dateStyle: 'short', timeStyle: 'short' }) %></td>
                                <td>
                                    <span class="phone-cell">
                                        <span class="phone-num"><%= log.to %></span>
                                        <button class="copy-mini-btn" onclick="copyText('<%= log.to %>', this)" title="نسخ الرقم">📋</button>
                                    </span>
                                </td>
                                <td class="msg-cell">
                                    <div class="msg-preview">
                                        <span class="msg-bubble-mini"><%= log.body %></span>
                                    </div>
                                </td>
                                <td>
                                    <% if (log.status === 'success') { %>
                                        <span class="badge badge-success">✅ ناجح</span>
                                    <% } else { %>
                                        <span class="badge badge-failed">❌ فاشل</span>
                                        <% if (log.errorDetails) { %>
                                            <span class="err-detail" title="<%= log.errorDetails %>"><%= log.errorDetails %></span>
                                        <% } %>
                                    <% } %>
                                </td>
                                <td>
                                    <button class="view-btn" onclick="openMessageModal(this)" title="عرض الرسالة كاملة">👁️ عرض</button>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <!-- ===== نافذة عرض الرسالة (أسلوب واتساب) ===== -->
    <div class="modal-overlay" id="messageModal">
        <div class="modal" style="max-width: 640px;">
            <div class="modal-head">
                <h3>💬 محتوى الرسالة</h3>
                <button type="button" class="modal-close" onclick="closeMessageModal()" title="إغلاق">✕</button>
            </div>
            <div class="modal-body">
                <div class="detail-wa-wrap">
                    <div class="detail-bubble" id="detailBubble">
                        <span id="detailText"></span>
                        <span class="dtime"><span class="double-check">✓✓</span> <span id="detailTime"></span></span>
                    </div>
                </div>
                <div class="detail-meta">
                    <div class="meta-item">
                        <label>📱 رقم المستلم</label>
                        <div class="val" id="detailPhone"></div>
                    </div>
                    <div class="meta-item">
                        <label>📌 الحالة</label>
                        <div class="val normal" id="detailStatus"></div>
                    </div>
                </div>
                <div class="err-box" id="detailError" style="display:none;">
                    <label>⚠️ سبب الفشل</label>
                    <span id="detailErrorText"></span>
                </div>
                <div class="meta-actions">
                    <button class="btn btn-green" onclick="copyDetailMessage()">📋 نسخ نص الرسالة</button>
                    <button class="btn btn-outline" onclick="copyDetailPhone()">📱 نسخ الرقم</button>
                    <a class="btn btn-blue" id="detailWaLink" target="_blank" rel="noopener" href="#">💬 فتح محادثة واتساب</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== نافذة عرض الأرقام ===== -->
    <div class="modal-overlay" id="numbersModal">
        <div class="modal" style="max-width: 720px;">
            <div class="modal-head">
                <h3>📱 أرقام المستلمين (<%= uniqueNumbers.length %>)</h3>
                <button type="button" class="modal-close" onclick="closeNumbersModal()" title="إغلاق">✕</button>
            </div>
            <div class="modal-body">
                <div class="nums-toolbar">
                    <span class="count-badge">عدد الأرقام الفريدة: <%= uniqueNumbers.length %></span>
                    <button class="btn btn-green" onclick="copyAllNumbers()">📋 نسخ جميع الأرقام</button>
                </div>
                <% if(uniqueNumbers.length === 0) { %>
                    <div class="nums-empty">لا توجد أرقام لعرضها</div>
                <% } else { %>
                    <div class="nums-grid">
                        <% uniqueNumbers.forEach(num => { %>
                            <div class="num-chip" onclick="copyText('<%= num %>', this.querySelector('.num-copy'))" title="اضغط للنسخ">
                                <span>📱 <%= num %></span>
                                <button class="num-copy" onclick="event.stopPropagation(); copyText('<%= num %>', this)">📋</button>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Modal: إعادة إرسال -->
    <div class="modal-overlay" id="resendModal">
        <div class="modal">
            <div class="modal-head">
                <h3>🔄 إعادة إرسال الرسائل</h3>
                <button type="button" class="modal-close" id="modalClose" title="إغلاق">✕</button>
            </div>
            <div class="modal-body" id="modalBody">
                <p style="color: var(--gray); font-size: 13px; margin-bottom: 14px;">
                    راجع الأرقام والنصوص قبل الإرسال. يمكنك تعديل أي رقم أو نص، أو إزالة عنصر من القائمة.
                </p>
                <div id="resendItemsContainer"></div>
                <div class="progress-bar" id="progressBar"><div class="progress-fill" id="progressFill"></div></div>
                <div class="result-box" id="resultBox"></div>
            </div>
            <div class="modal-foot">
                <span id="modalCounter" style="color: var(--gray); font-size: 13px; font-weight: 700;"></span>
                <div style="display:flex; gap:8px;">
                    <button type="button" class="btn btn-outline" id="btnCancelResend">إلغاء</button>
                    <button type="button" class="btn btn-green" id="btnConfirmResend">📤 إرسال الآن</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mini-toast" id="miniToast"></div>

    <script>
    (function() {
        const checkAll = document.getElementById('checkAll');
        const rowCheckboxes = () => Array.from(document.querySelectorAll('.row-checkbox'));
        const selectionInfo = document.getElementById('selectionInfo');
        const selectionCount = document.getElementById('selectionCount');
        const btnResendSelected = document.getElementById('btnResendSelected');
        const btnSelectFailed = document.getElementById('btnSelectFailed');

        function updateSelection() {
            const selected = rowCheckboxes().filter(c => c.checked);
            const count = selected.length;
            if (selectionCount) selectionCount.textContent = count;
            if (selectionInfo) selectionInfo.classList.toggle('active', count > 0);
            if (btnResendSelected) btnResendSelected.disabled = count === 0;
            if (checkAll) {
                const all = rowCheckboxes();
                checkAll.checked = count > 0 && count === all.length;
                checkAll.indeterminate = count > 0 && count < all.length;
            }
        }

        if (checkAll) {
            checkAll.addEventListener('change', () => {
                rowCheckboxes().forEach(c => { c.checked = checkAll.checked; });
                updateSelection();
            });
        }
        rowCheckboxes().forEach(c => c.addEventListener('change', updateSelection));

        if (btnSelectFailed) {
            btnSelectFailed.addEventListener('click', () => {
                rowCheckboxes().forEach(c => {
                    const tr = c.closest('tr');
                    c.checked = tr && tr.dataset.status === 'failed';
                });
                updateSelection();
            });
        }

        // ===== البحث الفوري =====
        window.applySearch = function() {
            const q = document.getElementById('searchInput').value.trim().toLowerCase();
            document.getElementById('searchClear').style.display = q ? 'block' : 'none';
            const rows = document.querySelectorAll('#logsTable tbody tr');
            let visible = 0;
            rows.forEach(tr => {
                const to = (tr.dataset.to || '').toLowerCase();
                const body = (tr.dataset.body || '').toLowerCase();
                const match = !q || to.includes(q) || body.includes(q);
                tr.style.display = match ? '' : 'none';
                if (match) visible++;
            });
        };
        window.clearSearch = function() {
            document.getElementById('searchInput').value = '';
            document.getElementById('searchClear').style.display = 'none';
            applySearch();
        };

        // ===== Toast =====
        let toastTimer = null;
        function showToast(msg, green) {
            const t = document.getElementById('miniToast');
            t.textContent = msg;
            t.className = 'mini-toast show' + (green ? ' green' : '');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => t.classList.remove('show'), 1800);
        }

        // ===== نسخ نص =====
        window.copyText = async function(text, btn) {
            try {
                await navigator.clipboard.writeText(text);
            } catch (e) {
                const ta = document.createElement('textarea');
                ta.value = text;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                ta.remove();
            }
            if (btn) {
                const old = btn.innerHTML;
                btn.innerHTML = '✅';
                btn.classList.add('copied');
                setTimeout(() => { btn.innerHTML = old; btn.classList.remove('copied'); }, 1200);
            }
            showToast('✅ تم نسخ: ' + text, true);
        };

        // ===== نافذة عرض الرسالة =====
        window.openMessageModal = function(btn) {
            const tr = btn.closest('tr');
            const body = tr.dataset.body || '';
            const to = tr.dataset.to || '';
            const status = tr.dataset.status || 'success';
            const err = tr.dataset.err || '';
            const time = tr.dataset.time ? new Date(tr.dataset.time) : null;

            document.getElementById('detailText').textContent = body;
            document.getElementById('detailTime').textContent = time ? time.toLocaleString('ar-EG', { dateStyle: 'medium', timeStyle: 'short' }) : '';
            document.getElementById('detailPhone').innerHTML = '<span>' + to + '</span> <button class="copy-mini-btn" onclick="copyText(\'' + to + '\', this)">📋</button>';
            document.getElementById('detailStatus').innerHTML = status === 'success'
                ? '<span class="badge badge-success">✅ ناجح</span>'
                : '<span class="badge badge-failed">❌ فاشل</span>';
            const errBox = document.getElementById('detailError');
            if (status === 'failed' && err) {
                errBox.style.display = 'block';
                document.getElementById('detailErrorText').textContent = err;
            } else {
                errBox.style.display = 'none';
            }
            document.getElementById('detailWaLink').href = 'https://wa.me/' + to.replace(/^0+/, '');
            document.getElementById('messageModal').classList.add('active');
        };
        window.closeMessageModal = function() { document.getElementById('messageModal').classList.remove('active'); };
        window.copyDetailMessage = function() { copyText(document.getElementById('detailText').textContent); };
        window.copyDetailPhone = function() {
            const t = document.getElementById('detailPhone').textContent.replace('📋','').trim();
            copyText(t);
        };

        // ===== نافذة عرض الأرقام =====
        window.openNumbersModal = function() { document.getElementById('numbersModal').classList.add('active'); };
        window.closeNumbersModal = function() { document.getElementById('numbersModal').classList.remove('active'); };
        window.copyAllNumbers = function() {
            const nums = Array.from(document.querySelectorAll('.num-chip')).map(c => c.querySelector('span').textContent.replace('📱','').trim());
            if (nums.length === 0) return;
            copyText(nums.join('\n'));
        };

        // إغلاق النوافذ بالنقر خارجها
        ['messageModal', 'numbersModal'].forEach(id => {
            document.getElementById(id).addEventListener('click', (e) => {
                if (e.target === document.getElementById(id)) document.getElementById(id).classList.remove('active');
            });
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                ['messageModal', 'numbersModal'].forEach(id => document.getElementById(id).classList.remove('active'));
            }
        });

        // Modal إعادة إرسال (نفس الوظيفة السابقة)
        const modal = document.getElementById('resendModal');
        const modalClose = document.getElementById('modalClose');
        const btnCancel = document.getElementById('btnCancelResend');
        const btnConfirm = document.getElementById('btnConfirmResend');
        const itemsContainer = document.getElementById('resendItemsContainer');
        const modalCounter = document.getElementById('modalCounter');
        const progressBar = document.getElementById('progressBar');
        const progressFill = document.getElementById('progressFill');
        const resultBox = document.getElementById('resultBox');

        function openModal() {
            const selected = rowCheckboxes().filter(c => c.checked).map(c => {
                const tr = c.closest('tr');
                return {
                    logId: tr.dataset.logId,
                    to: tr.dataset.to,
                    body: tr.dataset.body
                };
            });
            if (selected.length === 0) return;

            itemsContainer.innerHTML = '';
            selected.forEach((item, i) => {
                const el = document.createElement('div');
                el.className = 'resend-item';
                el.dataset.logId = item.logId;
                el.innerHTML =
                    '<div class="resend-item-head">' +
                        '<strong>#' + (i + 1) + '</strong>' +
                        '<button type="button" class="resend-remove" title="إزالة من القائمة">✕ إزالة</button>' +
                    '</div>' +
                    '<div class="resend-field">' +
                        '<label>📱 الرقم</label>' +
                        '<input type="text" class="resend-to" value="' + (item.to || '') + '" placeholder="9665XXXXXXXX">' +
                    '</div>' +
                    '<div class="resend-field">' +
                        '<label>💬 نص الرسالة</label>' +
                        '<textarea class="resend-body" rows="3" placeholder="نص الرسالة"></textarea>' +
                    '</div>';
                el.querySelector('.resend-body').value = item.body || '';
                el.querySelector('.resend-remove').addEventListener('click', () => {
                    el.remove();
                    refreshCounter();
                });
                itemsContainer.appendChild(el);
            });
            refreshCounter();
            resultBox.classList.remove('active', 'success', 'partial', 'error');
            resultBox.innerHTML = '';
            progressBar.classList.remove('active');
            progressFill.style.width = '0%';
            btnConfirm.disabled = false;
            btnConfirm.textContent = '📤 إرسال الآن';
            modal.classList.add('active');
        }

        function refreshCounter() {
            const n = itemsContainer.querySelectorAll('.resend-item').length;
            modalCounter.textContent = n + ' رسالة جاهزة';
            btnConfirm.disabled = n === 0;
        }

        function closeModal() { modal.classList.remove('active'); }

        if (btnResendSelected) btnResendSelected.addEventListener('click', openModal);
        if (modalClose) modalClose.addEventListener('click', closeModal);
        if (btnCancel) btnCancel.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

        async function doResend() {
            const items = Array.from(itemsContainer.querySelectorAll('.resend-item')).map(el => ({
                logId: el.dataset.logId,
                to: el.querySelector('.resend-to').value.trim(),
                body: el.querySelector('.resend-body').value
            }));

            let hasInvalid = false;
            items.forEach((it, i) => {
                const el = itemsContainer.children[i];
                el.classList.remove('invalid');
                const digits = (it.to || '').replace(/\D/g, '');
                if (digits.length < 10 || !it.body.trim()) {
                    el.classList.add('invalid');
                    hasInvalid = true;
                }
            });
            if (hasInvalid) {
                resultBox.className = 'result-box error active';
                resultBox.innerHTML = '<h4>❌ تحقق من الحقول</h4>هناك رقم غير صالح أو نص فارغ (مظلل بالأحمر).';
                return;
            }

            btnConfirm.disabled = true;
            btnConfirm.textContent = '⏳ جاري الإرسال...';
            progressBar.classList.add('active');
            progressFill.style.width = '30%';
            resultBox.classList.remove('active');

            try {
                const res = await fetch('/logs/resend', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ items })
                });
                progressFill.style.width = '90%';
                const data = await res.json();
                progressFill.style.width = '100%';

                if (!data.success) {
                    resultBox.className = 'result-box error active';
                    resultBox.innerHTML = '<h4>❌ فشل الإرسال</h4>' + (data.error || 'خطأ غير معروف');
                    btnConfirm.disabled = false;
                    btnConfirm.textContent = '📤 إعادة المحاولة';
                    return;
                }

                const cls = data.failedCount === 0 ? 'success' : (data.successCount === 0 ? 'error' : 'partial');
                const icon = cls === 'success' ? '✅' : (cls === 'error' ? '❌' : '⚠️');
                let html = '<h4>' + icon + ' الإرسال: ' + data.successCount + ' ناجحة / ' + data.failedCount + ' فاشلة (من ' + data.total + ')</h4>';
                if (data.failedCount > 0) {
                    html += '<ul>';
                    data.results.filter(r => !r.success).forEach(r => {
                        html += '<li>📵 ' + (r.to || '?') + ' — ' + (r.error || 'فشل') + '</li>';
                    });
                    html += '</ul>';
                }
                if (data.successCount > 0) {
                    html += '<div style="margin-top:8px; font-size:12px; opacity:0.85;">💡 سيتم تحديث الصفحة بعد 3 ثوان لعرض السجلات الجديدة.</div>';
                    setTimeout(() => location.reload(), 3000);
                }
                resultBox.className = 'result-box ' + cls + ' active';
                resultBox.innerHTML = html;
                btnConfirm.textContent = '📤 إرسال مرة أخرى';
                btnConfirm.disabled = false;
            } catch (e) {
                resultBox.className = 'result-box error active';
                resultBox.innerHTML = '<h4>❌ خطأ في الشبكة</h4>' + (e.message || 'تعذر الاتصال بالخادم');
                btnConfirm.disabled = false;
                btnConfirm.textContent = '📤 إعادة المحاولة';
            }
        }

        if (btnConfirm) btnConfirm.addEventListener('click', doResend);
        updateSelection();
    })();
    </script>
    <script src="/js/app.js"></script>
</body>
</html>

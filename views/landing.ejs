<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>واتساب تكوين | حلول واتساب للأعمال - إرسال جماعي ذكي</title>
    <meta name="description" content="نظام متكامل لإدارة الحملات التسويقية، المجموعات، والإرسال المجدول عبر واتساب للأعمال — أرسل رسائلك بضغطة واحدة وتابع النتائج لحظياً">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { font-family: 'Tajawal', sans-serif; background: #ffffff; color: #1e293b; overflow-x: hidden; }
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        a { text-decoration: none; }
        .whatsapp { color: #25D366; }
        .teal { color: #128C7E; }

        /* ===== Navbar ===== */
        nav { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.92); backdrop-filter: blur(12px); border-bottom: 1px solid #e5e7eb; }
        .nav-inner { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; max-width: 1200px; margin: 0 auto; }
        .logo { display: flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 900; color: #0f172a; }
        .logo-icon { width: 42px; height: 42px; border-radius: 12px; background: linear-gradient(135deg, #25D366, #128C7E); display: flex; align-items: center; justify-content: center; color: white; font-size: 22px; box-shadow: 0 6px 14px -4px rgba(37,211,102,.5); }
        .nav-links { display: flex; align-items: center; gap: 4px; }
        .nav-links a:not(.btn) { color: #475569; font-weight: 700; font-size: 15px; padding: 8px 14px; border-radius: 10px; transition: .25s; }
        .nav-links a:not(.btn):hover { color: #128C7E; background: #f0fdf4; }
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 800; border-radius: 12px; padding: 11px 22px; font-size: 15px; transition: .25s; border: 2px solid transparent; cursor: pointer; }
        .btn-green { background: #25D366; color: #fff !important; box-shadow: 0 8px 18px -6px rgba(37,211,102,.55); }
        .btn-green:hover { background: #1fb958; transform: translateY(-2px); }
        .btn-ghost { color: #128C7E !important; border-color: #128C7E; background: transparent; }
        .btn-ghost:hover { background: #f0fdf4; }
        .btn-white { background: #fff; color: #128C7E !important; border-color: #fff; box-shadow: 0 8px 18px -6px rgba(0,0,0,.25); }
        .btn-white:hover { transform: translateY(-2px); }
        .nav-cta { display: flex; gap: 10px; align-items: center; }
        .hamburger { display: none; background: none; border: none; font-size: 24px; color: #334155; cursor: pointer; }
        .mobile-menu { display: none; flex-direction: column; gap: 6px; padding: 10px 20px 16px; background: #fff; border-bottom: 1px solid #e5e7eb; }
        .mobile-menu a { padding: 10px 12px; border-radius: 10px; color: #334155; font-weight: 700; }
        .mobile-menu a:hover { background: #f0fdf4; color: #128C7E; }

        /* ===== Hero ===== */
        .hero { background: linear-gradient(160deg, #f0fdf4 0%, #d1fae5 55%, #f0fdf4 100%); padding: 70px 0 90px; position: relative; overflow: hidden; }
        .hero::before { content: ''; position: absolute; width: 500px; height: 500px; border-radius: 50%; background: radial-gradient(circle, rgba(37,211,102,.14), transparent 70%); top: -180px; left: -120px; }
        .hero::after { content: ''; position: absolute; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(18,140,126,.10), transparent 70%); bottom: -160px; right: -100px; }
        .hero-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1.1fr .9fr; gap: 50px; align-items: center; }
        .hero h1 { font-size: clamp(30px, 4.4vw, 52px); font-weight: 900; color: #0f172a; line-height: 1.25; margin-bottom: 18px; }
        .hero h1 span { background: linear-gradient(90deg, #128C7E, #25D366); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .hero p { font-size: 18px; color: #475569; line-height: 1.9; max-width: 560px; margin-bottom: 30px; }
        .hero-btns { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 26px; }
        .hero-trust { display: flex; flex-wrap: wrap; gap: 18px; color: #128C7E; font-weight: 700; font-size: 14px; }
        .hero-trust span { display: inline-flex; align-items: center; gap: 6px; }

        /* Chat mockup */
        .chat-mockup { position: relative; }
        .chat-card { background: #fff; border-radius: 24px; box-shadow: 0 30px 60px -20px rgba(18,140,126,.35); border: 1px solid #e5e7eb; overflow: hidden; max-width: 400px; margin: 0 auto; }
        .chat-header { background: linear-gradient(135deg, #075E54, #128C7E); padding: 14px 18px; display: flex; align-items: center; gap: 12px; }
        .chat-avatar { width: 42px; height: 42px; border-radius: 50%; background: #25D366; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20px; font-weight: 900; }
        .chat-header h4 { color: #fff; font-size: 15px; font-weight: 800; }
        .chat-header p { color: #dcfce7; font-size: 12px; }
        .chat-online { margin-right: auto; background: #25D366; color: #fff; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 20px; }
        .chat-body { background: #e5ddd5; padding: 18px 14px; min-height: 250px; display: flex; flex-direction: column; gap: 10px; }
        .bubble { max-width: 82%; padding: 9px 13px; border-radius: 14px; font-size: 13.5px; line-height: 1.7; position: relative; box-shadow: 0 1px 2px rgba(0,0,0,.08); }
        .bubble-in { background: #fff; align-self: flex-start; border-bottom-right-radius: 4px; }
        .bubble-out { background: #DCF8C6; align-self: flex-end; border-bottom-left-radius: 4px; }
        .bubble-time { display: block; font-size: 10px; color: #94a3b8; text-align: left; margin-top: 3px; }
        .chat-input { background: #f0f2f5; padding: 12px 14px; display: flex; align-items: center; gap: 10px; }
        .chat-input .fake { flex: 1; background: #fff; border-radius: 20px; padding: 9px 15px; font-size: 13px; color: #94a3b8; }
        .chat-input .mic { width: 38px; height: 38px; border-radius: 50%; background: #25D366; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 15px; }
        .float-badge { position: absolute; bottom: -14px; right: -10px; background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; padding: 9px 16px; font-size: 13px; font-weight: 800; color: #075E54; box-shadow: 0 12px 24px -8px rgba(0,0,0,.18); display: flex; align-items: center; gap: 8px; }
        .pulse-dot { width: 9px; height: 9px; border-radius: 50%; background: #25D366; animation: pulse 1.6s infinite; }
        @keyframes pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(37,211,102,.5);} 50% { box-shadow: 0 0 0 7px rgba(37,211,102,0);} }

        /* ===== Trust strip ===== */
        .trust { background: #075E54; padding: 34px 0; }
        .trust-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; text-align: center; }
        .trust-item h3 { color: #25D366; font-size: 30px; font-weight: 900; font-family: 'Tajawal', sans-serif; }
        .trust-item p { color: #cbd5e1; font-size: 14px; font-weight: 700; margin-top: 4px; }

        /* ===== Sections common ===== */
        .section { padding: 80px 0; }
        .section-head { text-align: center; max-width: 640px; margin: 0 auto 50px; }
        .section-head h2 { font-size: clamp(26px, 3vw, 38px); font-weight: 900; color: #0f172a; margin-bottom: 12px; }
        .section-head p { color: #64748b; font-size: 16px; line-height: 1.8; }
        .tag { display: inline-block; background: #f0fdf4; color: #128C7E; font-weight: 800; font-size: 13px; padding: 6px 14px; border-radius: 20px; margin-bottom: 14px; }

        /* ===== Features ===== */
        .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
        .feature-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 30px 26px; transition: .3s; position: relative; overflow: hidden; }
        .feature-card::after { content: ''; position: absolute; inset: 0 0 auto 0; height: 4px; background: linear-gradient(90deg, #25D366, #128C7E); opacity: 0; transition: .3s; }
        .feature-card:hover { transform: translateY(-6px); box-shadow: 0 24px 40px -16px rgba(18,140,126,.25); border-color: #a7f3d0; }
        .feature-card:hover::after { opacity: 1; }
        .feature-icon { width: 58px; height: 58px; border-radius: 16px; background: #f0fdf4; display: flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 18px; }
        .feature-card h3 { font-size: 19px; font-weight: 800; margin-bottom: 10px; }
        .feature-card p { color: #64748b; font-size: 14.5px; line-height: 1.8; }
        .feature-badge { position: absolute; top: 16px; left: 16px; background: #25D366; color: #fff; font-size: 11px; font-weight: 800; padding: 4px 12px; border-radius: 20px; }

        /* ===== How it works ===== */
        .how { background: #f8fafc; }
        .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; counter-reset: step; }
        .step-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 34px 26px; position: relative; text-align: center; }
        .step-num { width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #25D366, #128C7E); color: #fff; font-size: 22px; font-weight: 900; display: flex; align-items: center; justify-content: center; margin: 0 auto 18px; box-shadow: 0 10px 20px -6px rgba(37,211,102,.5); }
        .step-card h3 { font-size: 18px; font-weight: 800; margin-bottom: 10px; }
        .step-card p { color: #64748b; font-size: 14.5px; line-height: 1.8; }
        .step-arrow { position: absolute; top: 50%; left: -18px; color: #25D366; font-size: 22px; z-index: 2; }

        /* ===== Use cases ===== */
        .usecases-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
        .usecase-card { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 20px; padding: 30px 26px; transition: .3s; }
        .usecase-card:hover { transform: translateY(-6px); box-shadow: 0 20px 34px -14px rgba(18,140,126,.3); }
        .usecase-icon { font-size: 34px; margin-bottom: 14px; }
        .usecase-card h3 { font-size: 18px; font-weight: 800; margin-bottom: 10px; color: #0f172a; }
        .usecase-card p { color: #475569; font-size: 14.5px; line-height: 1.8; }

        /* ===== API ===== */
        .api { background: #f8fafc; }
        .api-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
        .api-box { background: #0b1220; border-radius: 20px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(0,0,0,.4); }
        .api-tabs { display: flex; background: #131c2e; border-bottom: 1px solid #1e293b; }
        .api-tab { flex: 1; text-align: center; padding: 13px 8px; color: #94a3b8; font-weight: 800; font-size: 13.5px; cursor: pointer; border-bottom: 3px solid transparent; transition: .2s; background: none; border-top: none; border-left: none; border-right: none; font-family: inherit; }
        .api-tab.active { color: #25D366; border-bottom-color: #25D366; }
        .api-code { padding: 20px; min-height: 250px; position: relative; direction: ltr; text-align: left; }
        .api-code pre { color: #dcfce7; font-size: 12.5px; line-height: 1.8; font-family: 'Courier New', monospace; white-space: pre-wrap; word-break: break-word; }
        .api-code .cmt { color: #64748b; }
        .api-code .k { color: #7dd3fc; }
        .api-code .s { color: #86efac; }
        .copy-btn { position: absolute; top: 12px; left: 12px; background: #1e293b; color: #cbd5e1; border: 1px solid #334155; border-radius: 8px; padding: 6px 12px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit; transition: .2s; }
        .copy-btn:hover { background: #25D366; color: #fff; border-color: #25D366; }
        .integrations { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
        .int-chip { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 10px 18px; font-weight: 800; font-size: 14px; color: #334155; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 2px 6px rgba(0,0,0,.04); }

        /* ===== Pricing ===== */
        .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: stretch; }
        .price-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 22px; padding: 34px 28px; display: flex; flex-direction: column; position: relative; transition: .3s; }
        .price-card:hover { transform: translateY(-6px); box-shadow: 0 24px 40px -16px rgba(18,140,126,.25); }
        .price-card.featured { border: 2px solid #25D366; box-shadow: 0 24px 50px -18px rgba(37,211,102,.4); }
        .popular-badge { position: absolute; top: -14px; right: 50%; transform: translateX(50%); background: linear-gradient(135deg, #25D366, #128C7E); color: #fff; font-size: 12px; font-weight: 800; padding: 6px 18px; border-radius: 20px; box-shadow: 0 8px 16px -6px rgba(37,211,102,.6); white-space: nowrap; }
        .plan-name { font-size: 17px; font-weight: 800; color: #475569; margin-bottom: 8px; }
        .plan-price { font-size: 46px; font-weight: 900; color: #0f172a; line-height: 1.1; }
        .plan-price small { font-size: 16px; color: #64748b; font-weight: 700; }
        .plan-desc { color: #94a3b8; font-size: 13.5px; margin: 8px 0 20px; }
        .plan-list { list-style: none; margin-bottom: 26px; flex: 1; }
        .plan-list li { padding: 9px 0; border-bottom: 1px solid #f1f5f9; font-size: 14.5px; color: #334155; display: flex; align-items: center; gap: 9px; }
        .plan-list li:last-child { border: none; }
        .plan-list .check { color: #25D366; font-weight: 900; font-size: 16px; }
        .price-card .btn { width: 100%; }

        /* ===== Testimonials ===== */
        .testi { background: #f8fafc; }
        .testi-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 900px; margin: 0 auto; }
        .testi-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 28px; }
        .testi-stars { color: #f5a524; font-size: 16px; letter-spacing: 3px; margin-bottom: 12px; }
        .testi-card p { color: #475569; font-size: 15px; line-height: 1.9; margin-bottom: 18px; }
        .testi-person { display: flex; align-items: center; gap: 12px; }
        .testi-avatar { width: 46px; height: 46px; border-radius: 50%; background: linear-gradient(135deg, #25D366, #128C7E); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 18px; }
        .testi-person h4 { font-size: 15px; font-weight: 800; }
        .testi-person p { font-size: 12.5px; color: #94a3b8; margin: 0; }

        /* ===== FAQ ===== */
        .faq-list { max-width: 760px; margin: 0 auto; }
        .faq-item { background: #fff; border: 1px solid #e5e7eb; border-radius: 16px; margin-bottom: 14px; overflow: hidden; }
        .faq-trigger { width: 100%; background: none; border: none; display: flex; justify-content: space-between; align-items: center; padding: 18px 22px; font-family: inherit; font-size: 16px; font-weight: 800; color: #0f172a; cursor: pointer; text-align: right; }
        .faq-trigger .plus { color: #25D366; font-size: 20px; transition: .3s; font-weight: 900; }
        .faq-item.open .plus { transform: rotate(45deg); }
        .faq-answer { display: none; padding: 0 22px 20px; color: #64748b; font-size: 14.5px; line-height: 1.9; }

        /* ===== CTA banner ===== */
        .cta-banner { background: linear-gradient(135deg, #075E54, #128C7E); border-radius: 28px; padding: 60px 40px; text-align: center; position: relative; overflow: hidden; }
        .cta-banner h2 { color: #fff; font-size: clamp(24px, 3vw, 34px); font-weight: 900; margin-bottom: 12px; }
        .cta-banner p { color: #d1fae5; font-size: 16px; margin-bottom: 28px; }

        /* ===== Footer ===== */
        footer { background: #0b1220; color: #94a3b8; padding: 60px 0 0; margin-top: 80px; }
        .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; padding-bottom: 40px; }
        .footer-brand .logo { color: #fff; margin-bottom: 14px; }
        .footer-brand p { font-size: 14px; line-height: 1.9; max-width: 320px; }
        .footer-col h4 { color: #fff; font-size: 16px; font-weight: 800; margin-bottom: 16px; }
        .footer-col a { display: block; color: #94a3b8; font-size: 14px; margin-bottom: 10px; transition: .2s; }
        .footer-col a:hover { color: #25D366; }
        .footer-bottom { border-top: 1px solid #1e293b; padding: 20px 0; text-align: center; font-size: 13.5px; }
        .footer-bottom a { color: #25D366; font-weight: 700; }

        /* ===== Responsive ===== */
        @media (max-width: 992px) {
            .hero-inner, .api-grid { grid-template-columns: 1fr; }
            .chat-card { max-width: 360px; }
            .features-grid, .steps-grid, .usecases-grid, .pricing-grid { grid-template-columns: repeat(2, 1fr); }
            .trust-grid { grid-template-columns: repeat(2, 1fr); gap: 26px; }
        }
        @media (max-width: 640px) {
            .nav-links a:not(.btn), .nav-cta .btn-ghost { display: none; }
            .hamburger { display: block; }
            .features-grid, .steps-grid, .usecases-grid, .pricing-grid, .testi-grid, .footer-grid { grid-template-columns: 1fr; }
            .step-arrow { display: none; }
            .section { padding: 56px 0; }
            .api-code pre { font-size: 11px; }
            .float-badge { right: 0; }
        }
    </style>
</head>
<body>
    <!-- ===== Navbar ===== -->
    <nav>
        <div class="nav-inner">
            <a href="/" class="logo"><span class="logo-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg></span> واتساب <span class="whatsapp">تكوين</span></a>
            <div class="nav-links">
                <a href="#features">المميزات</a>
                <a href="#how">كيف يعمل</a>
                <a href="#prices">الأسعار</a>
                <a href="#faq">الأسئلة الشائعة</a>
                <div class="nav-cta">
                    <% if (loggedIn) { %>
                        <a href="/dashboard" class="btn btn-green">لوحة التحكم ←</a>
                    <% } else { %>
                        <a href="/login" class="btn btn-ghost">تسجيل الدخول</a>
                        <a href="/register" class="btn btn-green">ابدأ مجاناً</a>
                    <% } %>
                </div>
            </div>
            <button class="hamburger" onclick="document.getElementById('mobileMenu').classList.toggle('open'); document.getElementById('mobileMenu').style.display = document.getElementById('mobileMenu').style.display === 'flex' ? 'none' : 'flex';">☰</button>
        </div>
        <div class="mobile-menu" id="mobileMenu">
            <a href="#features" onclick="this.parentElement.style.display='none'">المميزات</a>
            <a href="#how" onclick="this.parentElement.style.display='none'">كيف يعمل</a>
            <a href="#prices" onclick="this.parentElement.style.display='none'">الأسعار</a>
            <a href="#faq" onclick="this.parentElement.style.display='none'">الأسئلة الشائعة</a>
            <% if (loggedIn) { %>
                <a href="/dashboard" class="btn btn-green" style="justify-content:center;">لوحة التحكم ←</a>
            <% } else { %>
                <a href="/login" class="btn btn-ghost" style="justify-content:center;">تسجيل الدخول</a>
                <a href="/register" class="btn btn-green" style="justify-content:center;">ابدأ مجاناً</a>
            <% } %>
        </div>
    </nav>

    <!-- ===== Hero ===== -->
    <div class="hero">
        <div class="container hero-inner">
            <div>

    <div class="section api" id="api">
        <div class="container">
            <div class="api-grid">
                <div>
                    <span class="tag">🔌 تكامل مع API</span>
                    <h2 style="font-size: clamp(24px,3vw,34px); font-weight:900; margin-bottom:14px;">اربط نظامك مع واتساب برمجياً</h2>
                    <p style="color:#64748b; line-height:1.9; margin-bottom:10px;">واجهة برمجة تطبيقات قوية لربط واتساب للأعمال مع أنظمتك الأخرى — أرسل رسائل الفواتير والتنبيهات والإشعارات تلقائياً.</p>
                    <div class="integrations">
                        <span class="int-chip">⚡ Zapier</span>
                        <span class="int-chip">🛍️ Shopify</span>
                        <span class="int-chip">🛒 WooCommerce</span>
                        <span class="int-chip">📇 CRM</span>
                        <span class="int-chip">🏢 ERP</span>
                    </div>
                </div>
                <div class="api-box">
                    <div class="api-tabs">
                        <button class="api-tab active" onclick="switchApiTab('curl', this)">cURL</button>
                        <button class="api-tab" onclick="switchApiTab('php', this)">PHP</button>
                        <button class="api-tab" onclick="switchApiTab('node', this)">Node.js</button>
                    </div>
                    <div class="api-code">
                        <button class="copy-btn" onclick="copyApiCode()">📋 نسخ</button>
                        <pre id="code-curl"><span class="cmt"># إرسال رسالة واتساب عبر API</span>
curl -X POST https://<span style="color:#f0abfc;">{your-domain}</span>/api/v1/send \
  -H <span class="s">'Authorization: Bearer YOUR_API_KEY'</span> \
  -H <span class="s">'Content-Type: application/json'</span> \
  -d <span class="s">'{
    "to": "966501234567",
    "message": "مرحباً! هذا اختبار الإرسال"
  }'</span></pre>
                        <pre id="code-php" style="display:none;"><span class="cmt">// إرسال رسالة عبر PHP</span>
<span class="k">&lt;?php</span>
$curl = curl_init();
curl_setopt_array($curl, [
  CURLOPT_URL =&gt; <span class="s">"https://{your-domain}/api/v1/send"</span>,
  CURLOPT_RETURNTRANSFER =&gt; true,
  CURLOPT_POSTFIELDS =&gt; json_encode([
    <span class="s">'to'</span> =&gt; <span class="s">'966501234567'</span>,
    <span class="s">'message'</span> =&gt; <span class="s">'مرحباً من PHP!'</span>
  ]),
  CURLOPT_HTTPHEADER =&gt; [
    <span class="s">'Authorization: Bearer YOUR_API_KEY'</span>,
    <span class="s">'Content-Type: application/json'</span>
  ],
]);
$response = curl_exec($curl);
curl_close($curl);
<span class="k">echo</span> $response;</pre>
                        <pre id="code-node" style="display:none;"><span class="cmt">// إرسال رسالة عبر Node.js</span>
<span class="k">const</span> axios = <span class="k">require</span>(<span class="s">'axios'</span>);

axios({
  method: <span class="s">'post'</span>,
  url: <span class="s">'https://{your-domain}/api/v1/send'</span>,
  headers: {
    <span class="s">'Authorization'</span>: <span class="s">'Bearer YOUR_API_KEY'</span>
  },
  data: {
    to: <span class="s">'966501234567'</span>,
    message: <span class="s">'مرحباً من Node.js!'</span>
  }
})
.then(<span class="k">res</span> =&gt; console.log(res.data))
.catch(<span class="k">err</span> =&gt; console.error(err.message));</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>


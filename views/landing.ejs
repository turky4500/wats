    <script>
        // ===== FAQ accordion =====
        function toggleFaq(btn) {
            const item = btn.parentElement;
            const answer = item.querySelector('.faq-answer');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach(i => { i.classList.remove('open'); i.querySelector('.faq-answer').style.display = 'none'; });
            if (!isOpen) { item.classList.add('open'); answer.style.display = 'block'; }
        }

        // ===== API tabs =====
        function switchApiTab(lang, btn) {
            document.querySelectorAll('.api-tab').forEach(t => t.classList.remove('active'));
            btn.classList.add('active');
            ['curl', 'php', 'node'].forEach(l => { document.getElementById('code-' + l).style.display = (l === lang) ? 'block' : 'none'; });
        }

        // ===== Copy API code =====
        function copyApiCode() {
            const active = document.querySelector('.api-tab.active');
            const lang = active.textContent.trim().toLowerCase() === 'php' ? 'php' : (active.textContent.trim().toLowerCase() === 'node.js' ? 'node' : 'curl');
            const code = document.getElementById('code-' + lang).innerText;
            navigator.clipboard.writeText(code).then(() => {
                const btn = document.querySelector('.copy-btn');
                btn.textContent = '✅ تم النسخ';
                setTimeout(() => btn.textContent = '📋 نسخ', 1800);
            });
        }
    </script>

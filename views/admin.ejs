    <script src="/socket.io/socket.io.js"></script>
    <script>
        // ===== التبويبات =====
        function switchAdminTab(name, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            if (btn) btn.classList.add('active');
            else {
                const idx = { overview: 0, clients: 1, system: 2, settings: 3, payments: 4 }[name] || 0;
                document.querySelectorAll('.tab-btn')[idx].classList.add('active');
            }
            document.getElementById('tab-' + name).classList.add('active');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ===== اختبار بوابة الدفع فوراً (إنشاء فاتورة حقيقية) =====
        async function testPaymentGateway(btn) {
            const box = document.getElementById('testResult');
            const old = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري إنشاء فاتورة لدى ماي فاتورة...';
            box.style.display = 'block';
            box.innerHTML = '<span style="color:var(--ink-400);">جارٍ الاتصال بالبوابة...</span>';
            try {
                const res = await fetch('/admin/payments/test-invoice', { method: 'POST' });
                const data = await res.json();
                let html = '<div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:12px;">';
                html += '<strong style="color:var(--primary-dark);">✅ نجح الاتصال بالبوابة — الوضع: ' + (data.mode === 'live' ? 'حقيقي' : 'تجريبي') + '</strong><br>';
                (data.attempts || []).forEach(a => {
                    html += '<div style="margin-top:6px;">• ' + (a.success ? '✅' : '❌') + ' ' + a.method;
                    if (a.url) html += '<br><a href="' + a.url + '" target="_blank" style="color:var(--info); word-break:break-all; font-size:12px;">' + a.url + '</a>';
                    if (a.error) html += '<br><span style="color:var(--danger); font-size:12px;">' + a.error + '</span>';
                    html += '</div>';
                });
                html += '</div>';
                if (!data.success) {
                    html = '<div style="background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:12px;">';
                    html += '<strong style="color:var(--danger);">❌ فشل إنشاء الفاتورة:</strong><br>';
                    (data.attempts || []).forEach(a => {
                        html += '<div style="margin-top:6px;">• ' + a.method + ' → <span style="color:var(--danger);">' + (a.error || 'فشل') + '</span></div>';
                    });
                    html += '</div>';
                }
                box.innerHTML = html;
            } catch (e) {
                box.innerHTML = '<div style="background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:12px; color:var(--danger);">خطأ: ' + e.message + '</div>';
            } finally {
                btn.disabled = false;
                btn.innerHTML = old;
            }
        }

        // ===== إعادة التحقق من عملية دفع معلقة =====
        async function verifyPayment(id, btn) {
            if (!confirm('التحقق من هذه العملية لدى بوابة ماي فاتورة؟ إذا كان الدفع ناجحاً سيُجدد اشتراك العميل فوراً.')) return;
            const old = btn.innerHTML;
            btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التحقق...';
            try {
                const res = await fetch('/admin/payments/verify/' + id, { method: 'POST' });
                const data = await res.json();
                alert(data.message || 'تم');
                if (data.success) setTimeout(() => location.reload(), 800);
            } catch (e) {
                alert('تعذر التحقق: ' + e.message);
            } finally {
                btn.disabled = false; btn.innerHTML = old;
            }
        }

        // ===== بحث العملاء =====
        function filterUsers() {
            const q = document.getElementById('usersSearch').value.trim().toLowerCase();
            document.querySelectorAll('#usersTable tbody tr').forEach(tr => {
                const hay = (tr.dataset.search || '').toLowerCase();
                tr.style.display = (!q || hay.includes(q)) ? '' : 'none';
            });
        }

        // ===== تعديل العميل =====
        function openModal(id, username, phone, expDate, daysLeft) {
            document.getElementById('modalTitle').innerText = '⚙️ تعديل العميل: ' + username;
            document.getElementById('editForm').action = '/admin/edit-user/' + id;
            document.getElementById('modalPhone').value = phone || '';
            document.getElementById('modalExpiryDate').value = expDate || '';
            document.getElementById('editModal').classList.add('show');
        }

        // ===== تبويبات رقم الإدارة =====
        function switchSysTab(tab) {
            document.getElementById('sysQRTab').style.display = tab === 'qr' ? 'block' : 'none';
            document.getElementById('sysCodeTab').style.display = tab === 'code' ? 'block' : 'none';
            document.getElementById('sysTabQR').classList.toggle('active', tab === 'qr');
            document.getElementById('sysTabCode').classList.toggle('active', tab === 'code');
        }

        function getAdminPairingCode() {
            var phone = document.getElementById('adminPairingPhone').value.trim();
            if (!phone || phone.length < 10) { alert('أدخل رقم صحيح'); return; }
            var btn = document.getElementById('adminPairingBtn');
            btn.disabled = true; btn.innerText = '⏳';
            fetch('/admin/request-pairing-code', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phoneNumber: phone })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    var f = data.code.match(/.{1,4}/g).join(' - ');
                    document.getElementById('adminPairingResult').innerHTML =
                        '<div class="pairing-code-box"><div class="code">' + f + '</div>' +
                        '<div style="font-size:11px;color:var(--ink-400);margin-top:6px;">أدخل الرمز في واتساب ← الأجهزة المرتبطة ← ربط بالرقم</div></div>';
                } else {
                    document.getElementById('adminPairingResult').innerHTML = '<p style="color:var(--danger);font-weight:700;margin-top:8px;font-size:13px;">' + data.error + '</p>';
                }
                btn.disabled = false; btn.innerText = '🔑 توليد';
            })
            .catch(function() { alert('خطأ'); btn.disabled = false; btn.innerText = '🔑 توليد'; });
        }

        // ===== حالات اتصال رقم الإدارة =====
        var isAdminConnected = false;
        var sysSocket = io({ query: { userId: "111111111111111111111111" } });

        function showAdminConnected() {
            isAdminConnected = true;
            document.getElementById('sys-connected').style.display = 'block';
            document.getElementById('sys-link-section').style.display = 'none';
            document.getElementById('sys-status').innerHTML = '<span class="sys-dot on"></span> متصل وجاهز ✅';
            document.getElementById('sys-status').style.color = '#059669';
        }

        function showAdminLinkSection() {
            document.getElementById('sys-connected').style.display = 'none';
            document.getElementById('sys-link-section').style.display = 'block';
        }

        sysSocket.on('qr', function(imgData) {
            if (isAdminConnected) return;
            document.getElementById('sys-qr').src = imgData;
            showAdminLinkSection();
            document.getElementById('sys-status').innerHTML = '<span class="sys-dot off" style="background:#f59e0b;"></span> بانتظار الربط 📱';
            document.getElementById('sys-status').style.color = '#d97706';
        });

        sysSocket.on('ready', function() { showAdminConnected(); });

        sysSocket.on('reconnecting', function(msg) {
            isAdminConnected = false;
            document.getElementById('sys-connected').style.display = 'none';
            document.getElementById('sys-link-section').style.display = 'none';
            document.getElementById('sys-status').innerHTML = '<span class="sys-dot off" style="background:#f59e0b;"></span> 🔄 ' + msg;
            document.getElementById('sys-status').style.color = '#d97706';
        });

        sysSocket.on('disconnected', function(msg) {
            isAdminConnected = false;
            document.getElementById('sys-connected').style.display = 'none';
            document.getElementById('sys-status').innerHTML = '<span class="sys-dot off"></span> ❌ ' + msg;
            document.getElementById('sys-status').style.color = '#dc2626';
        });

        sysSocket.on('disconnect', function() {
            document.getElementById('sys-status').innerHTML = '<span class="sys-dot off"></span> ⚠️ انقطع الاتصال بالخادم';
            document.getElementById('sys-status').style.color = '#dc2626';
        });

        sysSocket.on('connect', function() {
            setTimeout(function() {
                if (!isAdminConnected && document.getElementById('sys-status').textContent.indexOf('بانتظار التحميل') !== -1) {
                    document.getElementById('sys-status').innerHTML = '<span class="sys-dot off"></span> غير متصل - اربط الرقم';
                    document.getElementById('sys-status').style.color = '#dc2626';
                    showAdminLinkSection();
                }
            }, 4000);
        });
    </script>
    <script src="/js/app.js"></script>
</body>
</html>

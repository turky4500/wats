<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الإدارة المركزية | واتساب تكوين</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: var(--font); background: var(--bg); background-image: var(--bg-grad); color: var(--ink-800); line-height: 1.7; }

        /* ===== الشريط العلوي ===== */
        .topbar {
            background: linear-gradient(135deg, #0b1220 0%, #131c2e 60%, #0b6e52 130%);
            color: white; padding: 0 30px; display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 100; height: 64px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.18);
        }
        .topbar-brand { display: flex; align-items: center; gap: 12px; font-weight: 900; font-size: 18px; }
        .topbar-brand .crown { font-size: 22px; }
        .topbar-actions { display: flex; gap: 8px; }
        .topbar-actions a {
            color: rgba(255,255,255,0.75); text-decoration: none; padding: 8px 16px; border-radius: 10px;
            font-size: 13px; font-weight: 700; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px;
        }
        .topbar-actions a:hover { background: rgba(255,255,255,0.1); color: white; }
        .topbar-actions .btn-logout { background: rgba(239,68,68,0.18); color: #fca5a5; }
        .topbar-actions .btn-logout:hover { background: rgba(239,68,68,0.32); }

        /* ===== الحاوية ===== */
        .container { max-width: 1400px; margin: 0 auto; padding: 26px 30px 60px; }

        /* ===== شريط التبويبات ===== */
        .tabs-bar {
            display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 26px;
            background: var(--card); border: 1px solid var(--ink-100); border-radius: var(--r-lg);
            padding: 8px; box-shadow: var(--shadow-sm); position: sticky; top: 76px; z-index: 90;
        }
        .tab-btn {
            display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px; border: none; border-radius: var(--r-sm);
            background: transparent; color: var(--ink-500); font-family: inherit; font-size: 14px; font-weight: 800;
            cursor: pointer; transition: all 0.2s; flex: 1; justify-content: center; min-width: 130px;
        }
        .tab-btn:hover { background: var(--ink-50); color: var(--primary-dark); }
        .tab-btn.active { background: linear-gradient(135deg, var(--primary), var(--primary-2)); color: white; box-shadow: var(--shadow-glow); }
        .tab-panel { display: none; animation: fadeIn 0.3s ease; }
        .tab-panel.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        /* ===== بطاقات الإحصائيات ===== */
        .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 18px; margin-bottom: 24px; }
        .stat-card {
            background: var(--card); border-radius: var(--r-lg); padding: 22px 24px; box-shadow: var(--shadow);
            position: relative; overflow: hidden; border: 1px solid var(--ink-100); transition: all 0.3s;
        }
        .stat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
        .stat-card .stat-icon {
            width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
            font-size: 22px; margin-bottom: 12px;
        }
        .stat-card .stat-label { font-size: 12.5px; color: var(--ink-400); font-weight: 700; }
        .stat-card .stat-value { font-size: 34px; font-weight: 900; color: var(--ink-900); line-height: 1.15; font-family: var(--font-num); }
        .stat-card .stat-bg { position: absolute; bottom: -14px; left: -8px; font-size: 84px; opacity: 0.045; }

        /* ===== البطاقات العامة ===== */
        .card { background: var(--card); border-radius: var(--r-lg); box-shadow: var(--shadow); border: 1px solid var(--ink-100); overflow: hidden; }
        .card-header { padding: 18px 24px; border-bottom: 1px solid var(--ink-50); display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
        .card-header h3 { font-size: 16px; font-weight: 800; display: flex; align-items: center; gap: 9px; color: var(--ink-900); }
        .card-body { padding: 22px 24px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-bottom: 22px; }
        .grid-2-1 { display: grid; grid-template-columns: 2fr 1fr; gap: 22px; margin-bottom: 22px; }
        .mb { margin-bottom: 22px; }

        /* ===== نموذج ===== */
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-weight: 700; font-size: 13px; color: var(--ink-500); margin-bottom: 6px; }
        .form-group input, .form-group select {
            width: 100%; padding: 11px 14px; border: 2px solid var(--ink-100); border-radius: var(--r-sm);
            font-family: inherit; font-size: 14px; outline: none; transition: border 0.2s; background: white; color: var(--ink-800);
        }
        .form-group input:focus, .form-group select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-glow); }
        .form-hint { font-size: 11.5px; color: var(--ink-300); margin-top: 5px; display: block; }
        .form-divider { border-top: 1px dashed var(--ink-100); margin: 22px 0; }

        /* ===== أزرار ===== */
        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 11px 22px;
            border: none; border-radius: var(--r-sm); font-family: inherit; font-weight: 800; font-size: 13.5px;
            cursor: pointer; text-decoration: none; transition: all 0.2s; color: white;
        }
        .btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-glow); }
        .btn-green { background: linear-gradient(135deg, var(--primary), var(--primary-2)); }
        .btn-blue { background: var(--info); }
        .btn-red { background: var(--danger); }
        .btn-dark { background: var(--ink-700); }
        .btn-outline { background: white; color: var(--ink-600); border: 2px solid var(--ink-100); }
        .btn-outline:hover { border-color: var(--primary); color: var(--primary-dark); box-shadow: none; }
        .btn-full { width: 100%; }
        .btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none !important; }

        /* ===== جدول العملاء ===== */
        .table-card { overflow: hidden; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
        thead th {
            background: var(--ink-50); color: var(--ink-400); font-weight: 800; padding: 13px 16px; text-align: right;
            font-size: 12px; letter-spacing: 0.3px; border-bottom: 2px solid var(--ink-100); white-space: nowrap;
        }
        tbody td { padding: 14px 16px; border-bottom: 1px solid var(--ink-50); vertical-align: middle; }
        tbody tr { transition: background 0.15s; }
        tbody tr:hover { background: #fafdff; }
        .user-cell { display: flex; align-items: center; gap: 11px; }
        .user-avatar {
            width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--primary-2));
            color: white; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 15px; flex-shrink: 0;
        }
        .user-name { font-weight: 800; color: var(--ink-900); font-size: 14px; }
        .user-phone { color: var(--ink-400); font-size: 12px; direction: ltr; text-align: right; font-family: var(--font-num); }

        .badge { display: inline-flex; align-items: center; gap: 5px; padding: 5px 13px; border-radius: 20px; font-size: 11.5px; font-weight: 800; white-space: nowrap; }
        .badge-green { background: var(--primary-soft); color: var(--primary-dark); }
        .badge-red { background: var(--danger-soft); color: var(--danger); }
        .badge-gray { background: var(--ink-50); color: var(--ink-400); }
        .badge-blue { background: var(--info-soft); color: var(--info); }
        .sub-date { font-size: 11px; color: var(--ink-400); margin-top: 4px; font-weight: 600; }

        .action-btns { display: flex; gap: 6px; flex-wrap: wrap; }
        .action-btn {
            padding: 7px 13px; border: none; border-radius: 9px; cursor: pointer; font-family: inherit; font-weight: 800;
            color: white; font-size: 11.5px; transition: all 0.2s; text-decoration: none; display: inline-flex; align-items: center; gap: 5px;
        }
        .action-btn:hover { transform: translateY(-1px); box-shadow: 0 3px 8px rgba(0,0,0,0.15); }
        .action-btn.blue { background: var(--info); }
        .action-btn.dark { background: var(--ink-700); }
        .action-btn.purple { background: var(--violet); }
        .action-btn.red { background: var(--danger); }
        .action-btn.green { background: var(--primary); }

        /* ===== رقم الإدارة ===== */
        .sys-wrap { background: linear-gradient(135deg, #f0fdf4 0%, #f8fafc 100%); border: 1px solid #bbf7d0; border-radius: var(--r-lg); padding: 22px; }
        #sys-status { font-weight: 800; font-size: 14.5px; display: flex; align-items: center; gap: 9px; margin-bottom: 14px; }
        #sys-qr { width: 190px; border-radius: 14px; border: 3px solid #d1fae5; padding: 8px; background: white; }
        .sys-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
        .sys-dot.on { background: var(--whatsapp); box-shadow: 0 0 0 3px rgba(37,211,102,0.2); animation: gpulse 2s infinite; }
        .sys-dot.off { background: var(--danger); }
        @keyframes gpulse { 0%,100% { box-shadow: 0 0 0 3px rgba(37,211,102,0.2); } 50% { box-shadow: 0 0 0 8px rgba(37,211,102,0.05); } }
        .sys-tabs { display: flex; border-radius: 10px; overflow: hidden; border: 2px solid #bbf7d0; margin-bottom: 12px; }
        .sys-tabs button {
            flex: 1; padding: 9px; font-weight: 800; font-size: 12px; cursor: pointer; background: white; color: var(--ink-400);
            border: none; font-family: inherit; transition: all 0.2s;
        }
        .sys-tabs button.active { background: var(--primary); color: white; }
        .pairing-row { display: flex; gap: 6px; }
        .pairing-row input {
            flex: 1; border: 2px solid #d1fae5; border-radius: 10px; padding: 10px 12px; font-size: 13px; outline: none; direction: ltr; font-family: var(--font-num);
        }
        .pairing-code-box {
            background: white; border: 2px solid #86efac; border-radius: 12px; padding: 14px; text-align: center; margin-top: 10px;
        }
        .pairing-code-box .code {
            font-size: 26px; font-weight: 900; letter-spacing: 6px; color: var(--primary-deep); font-family: monospace; direction: ltr;
        }

        /* ===== الرسم البياني ===== */
        .bar-chart { display: flex; align-items: flex-end; gap: 8px; height: 150px; padding-top: 10px; border-bottom: 2px solid var(--ink-50); }
        .bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 4px; }
        .bar { width: 100%; border-radius: 6px 6px 0 0; transition: height 0.8s cubic-bezier(0.34, 1.56, 0.64, 1); min-height: 4px; background: linear-gradient(180deg, var(--primary), var(--primary-2)); }
        .bar-label { font-size: 10.5px; color: var(--ink-300); margin-top: 6px; }
        .bar-value { font-size: 11px; font-weight: 800; color: var(--ink-600); }

        /* ===== الأكثر إرسالاً ===== */
        .rank-list { list-style: none; }
        .rank-item { display: flex; align-items: center; justify-content: space-between; padding: 11px 0; border-bottom: 1px solid var(--ink-50); }
        .rank-item:last-child { border: none; }
        .rank-info { display: flex; align-items: center; gap: 11px; }
        .rank-medal { font-size: 20px; width: 28px; text-align: center; }
        .rank-name { font-weight: 700; font-size: 13.5px; color: var(--ink-800); }
        .rank-count { background: var(--primary-soft); padding: 4px 13px; border-radius: 20px; font-size: 11.5px; font-weight: 800; color: var(--primary-dark); }

        /* ===== البحث ===== */
        .search-input {
            width: 240px; padding: 10px 14px 10px 36px; border: 2px solid var(--ink-100); border-radius: 10px;
            font-family: inherit; font-size: 13px; outline: none; transition: all 0.2s; background: white; position: relative;
        }
        .search-wrap { position: relative; }
        .search-wrap .s-icon { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: var(--ink-300); font-size: 13px; pointer-events: none; }

        /* ===== مودال ===== */
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(11,18,32,0.6); backdrop-filter: blur(4px); align-items: center; justify-content: center; z-index: 1000; padding: 18px; }
        .modal-overlay.show { display: flex; }
        .modal-box { background: white; border-radius: 20px; width: 100%; max-width: 460px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.3); animation: modalIn 0.25s ease; max-height: 92vh; overflow-y: auto; }
        @keyframes modalIn { from { opacity: 0; transform: scale(0.96) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
        .modal-header { padding: 20px 24px; border-bottom: 1px solid var(--ink-50); background: linear-gradient(135deg, var(--primary-soft), #f8fafc); }
        .modal-header h3 { font-size: 17px; font-weight: 900; color: var(--ink-900); }
        .modal-body { padding: 22px 24px; }
        .modal-footer { padding: 15px 24px; border-top: 1px solid var(--ink-50); display: flex; gap: 10px; justify-content: flex-end; }

        .empty-state { text-align: center; padding: 40px 20px; color: var(--ink-300); font-size: 14px; }

        /* ===== استجابة ===== */
        @media (max-width: 900px) {
            .container { padding: 18px 14px; }
            .topbar { padding: 0 14px; }
            .grid-2, .grid-2-1 { grid-template-columns: 1fr; }
            .stats-row { grid-template-columns: repeat(2, 1fr); }
            .tabs-bar { position: static; }
            .search-input { width: 100%; }
        }
        @media (max-width: 600px) {
            .stats-row { grid-template-columns: 1fr; }
            .action-btns { flex-direction: column; }
            .topbar-brand .brand-text { display: none; }
        }
    </style>
</head>
<body>
    <!-- ===== الشريط العلوي ===== -->
    <div class="topbar">
        <div class="topbar-brand">
            <span class="crown">👑</span>
            <span class="brand-text">الإدارة المركزية</span>
        </div>
        <div class="topbar-actions">
            <a href="/dashboard">📊 لوحتي</a>
            <a href="/logout" class="btn-logout">🚪 خروج</a>
        </div>
    </div>

    <div class="container">
        <!-- ===== شريط التبويبات ===== -->
        <div class="tabs-bar">
            <button class="tab-btn active" onclick="switchAdminTab('overview', this)">📊 نظرة عامة</button>
            <button class="tab-btn" onclick="switchAdminTab('clients', this)">👥 العملاء (<%= users.length %>)</button>
            <button class="tab-btn" onclick="switchAdminTab('system', this)">🤖 رقم الإدارة</button>
            <button class="tab-btn" onclick="switchAdminTab('settings', this)">⚙️ الإعدادات</button>
            <button class="tab-btn" onclick="switchAdminTab('payments', this)">💳 الدفعات (<%= (typeof payments !== 'undefined' && payments ? payments : []).filter(p=>p.status==='pending').length %>)</button>        </div>

        <!-- ============ تبويب: نظرة عامة ============ -->
        <div class="tab-panel active" id="tab-overview">
            <%
                const activeClients = users.filter(u => { let d = u.subscriptionEndsAt ? Math.ceil((new Date(u.subscriptionEndsAt) - new Date()) / 86400000) : 0; return d > 0; }).length;
                let maxCount = 0; dailyStats.forEach(s => { if(s.count > maxCount) maxCount = s.count; }); if(maxCount===0) maxCount=1;
            %>
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-bg">👥</div>
                    <div class="stat-icon" style="background:var(--violet-soft); color:var(--violet);">👥</div>
                    <div class="stat-label">إجمالي العملاء</div>
                    <div class="stat-value"><%= users.length %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-bg">📨</div>
                    <div class="stat-icon" style="background:var(--primary-soft); color:var(--primary);">📨</div>
                    <div class="stat-label">إجمالي الرسائل</div>
                    <div class="stat-value"><%= totalSystemMessages %></div>
                </div>
                <div class="stat-card">
                    <div class="stat-bg">✅</div>
                    <div class="stat-icon" style="background:var(--info-soft); color:var(--info);">✅</div>
                    <div class="stat-label">عملاء باشتراك فعّال</div>
                    <div class="stat-value"><%= activeClients %></div>
                </div>
                <div class="stat-card" style="cursor:pointer;" onclick="switchAdminTab('clients', document.querySelectorAll('.tab-btn')[1])" title="إدارة العملاء">
                    <div class="stat-bg">⚡</div>
                    <div class="stat-icon" style="background:#fef3c7; color:#d97706;">⚡</div>
                    <div class="stat-label">إجراءات سريعة</div>
                    <div class="stat-value" style="font-size:16px; font-weight:800; padding-top:8px;">إضافة / تعديل / سجل ←</div>
                </div>
            </div>

            <div class="grid-2-1">
                <div class="card">
                    <div class="card-header"><h3>📈 إحصائية الرسائل — آخر 7 أيام</h3></div>
                    <div class="card-body">
                        <% if(dailyStats.length===0) { %>
                            <div class="empty-state">لا توجد بيانات إرسال خلال آخر 7 أيام</div>
                        <% } else { %>
                            <div class="bar-chart">
                                <% dailyStats.forEach(s => { let hp = (s.count/maxCount)*100; %>
                                <div class="bar-col">
                                    <div class="bar-value"><%= s.count %></div>
                                    <div class="bar" style="height: <%= hp %>%;"></div>
                                    <div class="bar-label"><%= s._id.split('-')[2] %>/<%= s._id.split('-')[1] %></div>
                                </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header"><h3>🏆 الأكثر إرسالاً</h3></div>
                    <div class="card-body" style="padding-top: 10px;">
                        <ul class="rank-list">
                            <% topUsers.forEach((t, i) => { %>
                            <li class="rank-item">
                                <div class="rank-info">
                                    <span class="rank-medal"><%= i===0?'🥇':(i===1?'🥈':(i===2?'🥉':'👤')) %></span>
                                    <span class="rank-name"><%= t.username %></span>
                                </div>
                                <span class="rank-count"><%= t.count %> رسالة</span>
                            </li>
                            <% }) %>
                            <% if(topUsers.length===0) { %><li class="rank-item" style="justify-content:center;color:var(--ink-300);">لا توجد إحصائيات بعد</li><% } %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ تبويب: العملاء ============ -->
        <div class="tab-panel" id="tab-clients">
            <!-- إضافة عميل -->
            <div class="card mb">
                <div class="card-header">
                    <h3>➕ إضافة عميل جديد <span class="badge badge-green">+<%= settings.freeTrialDays %> أيام مجاناً</span></h3>
                </div>
                <div class="card-body">
                    <form method="POST" action="/admin/add-user" class="add-user-form" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
                        <div class="form-group" style="flex:1; min-width:160px; margin:0;">
                            <label>اسم المستخدم</label>
                            <input type="text" name="username" placeholder="مثال: ahmed_store" required>
                        </div>
                        <div class="form-group" style="flex:1; min-width:160px; margin:0;">
                            <label>رقم الجوال</label>
                            <input type="text" name="phone" placeholder="9665xxxxxxxx" dir="ltr">
                        </div>
                        <div class="form-group" style="flex:1; min-width:160px; margin:0;">
                            <label>كلمة المرور</label>
                            <input type="password" name="password" placeholder="••••••" required>
                        </div>
                        <button type="submit" class="btn btn-green" style="height:44px;">✅ إنشاء وتفعيل</button>
                    </form>
                </div>
            </div>

            <!-- جدول العملاء -->
            <div class="card table-card">
                <div class="card-header">
                    <h3>👥 قائمة العملاء (<%= users.length %>)</h3>
                    <div class="search-wrap">
                        <span class="s-icon">🔎</span>
                        <input type="text" class="search-input" id="usersSearch" placeholder="ابحث بالاسم أو الرقم..." oninput="filterUsers()">
                    </div>
                </div>
                <div class="table-wrap">
                    <table id="usersTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>المستخدم</th>
                                <th>الجوال</th>
                                <th>الاشتراك</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach((u, idx) => {
                                let daysLeft = 0;
                                if(u.subscriptionEndsAt) { daysLeft = Math.ceil((new Date(u.subscriptionEndsAt) - new Date()) / 86400000); if(daysLeft<0) daysLeft=0; }
                                const initial = (u.username || '؟').charAt(0).toUpperCase();
                            %>
                            <tr data-search="<%= (u.username || '').toLowerCase() %> <%= (u.phone || '').toLowerCase() %>">
                                <td style="color:var(--ink-300); font-weight:800;"><%= idx+1 %></td>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar"><%= initial %></div>
                                        <div>
                                            <div class="user-name"><%= u.username %></div>
                                            <div style="font-size:11px;color:var(--ink-300);"><%= u.isActive ? 'مفعل' : 'معطل' %></div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="user-phone"><%= u.phone || '—' %></span></td>
                                <td>
                                    <span class="badge <%= daysLeft>0 ? 'badge-green' : 'badge-red' %>">
